{
  "name": "cecistudy-desktop",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --experimental-strip-types --test \"src/features/calendar/domain/*.test.ts\" \"src/features/calendar/data/*.test.ts\" \"src/features/calendar/ui/*.test.ts\" \"src/features/faculdade/data/*.test.ts\" \"src/features/faculdade/ui/*.test.ts\" \"src/features/estudos/data/*.test.ts\" \"src/features/estudos/ui/*.test.ts\" \"src/features/tcc/data/*.test.ts\" \"src/features/tcc/ui/*.test.ts\" \"src/shell/*.test.ts\" \"src/components/*.test.ts\" \"src/lib/*.test.ts\"",
    "test:golden": "node --experimental-strip-types --test \"src/features/calendar/domain/*.golden.test.ts\"",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:gate": "node scripts/test-gate-dono.mjs",
    "verify:rust:domain": "cd src-tauri && cargo test --lib --no-default-features",
    "verify:rust:clippy": "cd src-tauri && cargo clippy --all-targets --all-features -- -D warnings",
    "verify:rust:fmt": "cd src-tauri && cargo fmt --all -- --check",
    "verify:rust:shell": "cd src-tauri && cargo check --all-targets",
    "verify:rust": "npm run verify:rust:domain && npm run verify:rust:clippy && npm run verify:rust:fmt && npm run verify:rust:shell",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:golden && npm run check:boundaries && npm run test:gate && npm run verify:rust",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:exe": "tauri build --no-bundle"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.12.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rrule": "^2.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "8.1.5"
  }
}
